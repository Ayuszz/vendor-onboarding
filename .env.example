# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────
# Leave empty to use the embedded Postgres (PGlite) stored in PGLITE_DIR — zero setup.
# Set to a real Postgres for staging/production, e.g. postgres://vo:vo@localhost:5432/vendor_onboarding
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ── Files ────────────────────────────────────────────
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=10

# ── Auth ─────────────────────────────────────────────
# dev  = demo sign-in screen with seeded users (refused when NODE_ENV=production)
# jwt  = only accept HS256 tokens signed with JWT_SECRET (issue them from your SSO)
AUTH_MODE=dev
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_SECONDS=28800

# ── SAP ──────────────────────────────────────────────
# mock = simulated SAP (local dev)   service_layer = SAP Business One Service Layer
SAP_MODE=mock
SAP_BASE_URL=https://sap.example.com:50000/b1s/v1
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
SAP_CARD_CODE_PREFIX=V
SAP_MAX_ATTEMPTS=5

# ── Background worker ────────────────────────────────
WORKER_ENABLED=true
WORKER_POLL_MS=1000
