# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────
# Leave empty to use the embedded Postgres (PGlite) stored in PGLITE_DIR — zero setup.
# Set to a real Postgres for staging/production, e.g. postgres://vo:vo@localhost:5432/vendor_onboarding
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ── Files ────────────────────────────────────────────
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=10

# ── Auth ─────────────────────────────────────────────
# dev  = demo sign-in screen with seeded users (refused when NODE_ENV=production)
# jwt  = only accept HS256 tokens signed with JWT_SECRET (issue them from your SSO)
AUTH_MODE=dev
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_TTL_SECONDS=28800

# ── Vendor sign-in emails ────────────────────────────
# Vendors sign in with a 6-digit code that is ONLY delivered by email. The server stores an
# HMAC of the code (never the code), checks what the vendor types, and then signs them in.
#
# MAILER=smtp     send real emails (required in production)
# MAILER=console  send nothing; in development the email is printed to the SERVER terminal only
MAILER=console
# Examples: smtp.office365.com:587 (Microsoft 365), smtp.gmail.com:587 (Google Workspace,
# use an app password), email-smtp.ap-south-1.amazonaws.com:587 (Amazon SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true only for port 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vendor Portal <no-reply@your-company.com>"

# Local testing only: ALSO show the code in the browser so you can sign in without an inbox.
# Leave false on any shared or public server. The app refuses to start with it in production.
DEV_SHOW_OTP=false

# ── SAP ──────────────────────────────────────────────
# mock = simulated SAP (local dev)   service_layer = SAP Business One Service Layer
SAP_MODE=mock
SAP_BASE_URL=https://sap.example.com:50000/b1s/v1
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
SAP_CARD_CODE_PREFIX=V
SAP_MAX_ATTEMPTS=5

# ── Background worker ────────────────────────────────
WORKER_ENABLED=true
WORKER_POLL_MS=1000
