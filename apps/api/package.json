{
  "name": "@vo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/cli.ts seed"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/cors": "^11.4.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "@vo/shared": "0.1.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
